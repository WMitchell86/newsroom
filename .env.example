# Copy to .env for local development. Never commit .env with real credentials.
# M0: no production credentials required. All values below are safe placeholders.

ENV=local
LOG_LEVEL=INFO
# Safety defaults — do NOT change without human review (see AI_HARNESS_EDITOR_ASSISTANT.md §2.1).
AUTO_PUBLISH=false
DRY_RUN=true
# M1.4B Telegram TEST delivery (placeholders only — real values via environment, never committed).
TELEGRAM_TEST_BOT_TOKEN=
TELEGRAM_TEST_CHAT_ID=
# M2S Track S: search reliability foundation (harness A3). Without any key the
# search layer reports SEARCH_CAPABILITY_UNAVAILABLE - it never fabricates results.
# M2S-R2 capability stack: NEWS -> google_news_rss / serper / ddgs / brave;
# WEB -> serper / ddgs / brave; BACKGROUND -> wikipedia. Keys are optional:
# absent key = that provider is unavailable, the rest of the chain still works.
# SEARCH_PROVIDER pins a single provider instead of the capability chain.
SEARCH_PROVIDER=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
# ddgs: approved optional dependency (scope change, see handoff M2S-R2).
# Install: python3 -m pip install --user --break-system-packages ddgs
