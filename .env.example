# Copy to .env for local development. Never commit .env with real credentials.
# M0: no production credentials required. All values below are safe placeholders.

ENV=local
LOG_LEVEL=INFO
# Safety defaults — do NOT change without human review (see AI_HARNESS_EDITOR_ASSISTANT.md §2.1).
AUTO_PUBLISH=false
DRY_RUN=true
# M1.4B Telegram TEST delivery (placeholders only — real values via environment, never committed).
TELEGRAM_TEST_BOT_TOKEN=
TELEGRAM_TEST_CHAT_ID=
# M2S Track S: search reliability foundation (harness A3). Without any key the
# search layer reports SEARCH_CAPABILITY_UNAVAILABLE - it never fabricates results.
# M2S-R4 capability stack: NEWS -> google_news_rss / tinyfish / serper / ddgs /
# brave; WEB -> tinyfish / serper / ddgs / brave; BACKGROUND -> wikipedia /
# tinyfish / serper / ddgs. Keys are optional: absent key = that provider is
# unavailable (tinyfish -> explicit tinyfish:no-key), the rest of the chain
# still works.
# SEARCH_PROVIDER pins a single provider instead of the capability chain.
SEARCH_PROVIDER=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
# M2S-R4: TinyFish Search is ADOPTED as the first general WEB provider.
# TinyFish Fetch stays AVAILABLE/NOT_YET_PROVEN (narrow fallback only).
TINYFISH_API_KEY=
# ddgs: approved optional dependency (scope change, see handoff M2S-R2).
# Install: python3 -m pip install --user --break-system-packages ddgs

# M3B.1 YouTube intake anti-ban / pacing (see RUNBOOK.md and
# m3/review/M3B1_INTAKE_HARDENING_REPORT.md). All defaults are conservative;
# these exist so the operator can tune pacing without editing code.
# Pacing: one video at a time, a random pause between them, a small nightly cap.
YOUTUBE_NIGHTLY_CAP=5
YOUTUBE_DELAY_MIN_S=60
YOUTUBE_DELAY_MAX_S=120
# Random startup delay applied only by `youtube-batch run --cron`, so the nightly
# job has no fixed request signature.
YOUTUBE_STARTUP_JITTER_MIN_S=600
YOUTUBE_STARTUP_JITTER_MAX_S=2400
# Retry ladder 15m -> 1h -> 6h -> 24h, then the video is parked as `blocked`.
YOUTUBE_MAX_ATTEMPTS=5
# Circuit breaker: the first explicit block stops the run and cools the IP down.
YOUTUBE_BLOCK_COOLDOWN_H=12
# Player clients rotated per video (community-reported to pass the checks the
# default web client fails). Empty = yt-dlp default client only.
YOUTUBE_PLAYER_CLIENTS=tv_simply,web_safari
# Browser identity. Off by default: TLS impersonation needs the optional
# `curl-cffi` extra (pip install -e '.[youtube]'), and a cookie file is a
# Netscape-format export from a LOGGED-OUT browsing session only - never your
# real Google account.
YOUTUBE_IMPERSONATE=
YOUTUBE_COOKIES_FILE=
YOUTUBE_PROXY=
# Invidious fallback: after YouTube pushes back, captions are fetched through a
# public instance so this IP stops touching YouTube. OFF by default - it sends
# the video id to an unrelated third party, and the 2026-09-19 probe found 0 of
# 9 public instances serving captions. Set to `on` only if you accept that.
YOUTUBE_FALLBACK=off
YOUTUBE_INVIDIOUS_INSTANCES=https://inv.nadeko.net,https://yewtu.be,https://invidious.nerdvpn.de
# NB: a value outside its safety bound is clamped, not applied, and the run
# prints a `policy warning:` line saying so (e.g. NIGHTLY_CAP above 50).
#
# ---------- Model / provider selection (M2.3 generation fallback) ----------
# One file owns the whole fallback chain: src/editor_assistant/drafting/generate.py.
# The resolution order is: explicit api_key -> GEMINI_API_KEY -> OPENROUTER_API_KEY
# -> RuntimeError.  `role` only picks the *model pool*, not the provider.
#
# Gemini model ORDER per role — comma-separated, first = tried first.  A model that
# returns a daily-quota 429 is skipped for the rest of the process.  Defaults:
#   GEMINI_DRAFT_MODELS (role="draft", quality-critical):
GEMINI_DRAFT_MODELS=gemini-2.5-flash,gemini-3-flash,gemini-3.5-flash,gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash,gemini-3-flash-preview
#     2.5 Flash (0/20 RPD) and 3 Flash (10/20 RPD) are the ONLY fresh Gemini text-out
#     buckets in the 2026-09-19 AI Studio quota snapshot; the 3.x family (3.5/3.6/3.7/3.8
#     Flash) is RPD-exhausted (22/20 each) and kept only to resume after a reset (it will
#     429 and be skipped until then).
#   GEMINI_JUDGE_MODELS (role="judge", cheap entailment / fact grounding):
GEMINI_JUDGE_MODELS=gemini-2.5-flash-lite,gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview,gemini-flash-lite-latest
#     2.5 Flash Lite (0/20 RPD, 10 RPM) is the fresh judge bucket.  3.1 Flash Lite is
#     RPD-exhausted (503/500) in that snapshot — kept to resume after a reset.  3.5 Flash
#     Lite is intentionally absent: it rejects thinkingConfig with 400 (even budget=0).
#     3.1 Flash Lite / its preview accept thinkingConfig and are the proven workhorses.
#
# Gemini quota snapshot (2026-09-19, AI Studio + Gemini API shared quota, Text-out models,
# format used/limit).  RPM pacing: 2.5 Flash Lite = 10 RPM (5s default safe); 2.5 Flash /
# 3 Flash = 5 RPM (5s ≈ 12 calls/min can exceed the cap under a heavy batch → set
# GEMINI_MIN_GAP_SECONDS=12 if you see self-inflicted 429s on those two).
#   gemini-3.5-flash        RPM 3/5   TPM 11.07K/250K  RPD 22/20  (exhausted)
#   gemini-3.6-flash        RPM 5/5   TPM 5.41K/250K   RPD 22/20  (exhausted)
#   gemini-3.7-flash        RPM 4/5   TPM 12.49K/250K  RPD 22/20  (exhausted)
#   gemini-3.8-flash        RPM 3/5   TPM 13.63K/250K  RPD 22/20  (exhausted)
#   gemini-3-flash          RPM 2/5   TPM 9.09K/250K   RPD 10/20   (half-used, fallback)
#   gemini-2.5-flash        RPM 0/5   TPM 0/250K       RPD 0/20    (fresh, fallback)
#   gemini-2.5-flash-lite   RPM 0/10  TPM 0/250K       RPD 0/20    (fresh, judge only)
#   gemini-3.1-flash-lite   RPM 20/15 TPM 67.33K/250K  RPD 503/500  (exhausted, judge pool)
#   gemini-3.5-flash-lite   RPM 15/15 TPM 25.28K/250K  RPD 288/500  (nearly exhausted;
#                             dropped from judge pool — rejects thinkingConfig 400)
#   0/0-allocated models (Gemini 2 Flash, 2 Flash Lite, Gemini 2.5 Pro, Gemini 3.1 Pro,
#   Gemini 2.5 Flash TTS, etc.): not usable.
#   -preview/-latest judge suffixes: endpoint model ids not verifiable here without a live
#   key (Gemini models.list returned 403); assumed gemini-3.1-flash-lite-preview /
#   gemini-flash-lite-latest.  Whether they share the 503/500 RPD bucket or have their own
#   is unconfirmed — verify with a live key before relying on them.
#
# OpenRouter model (used only when no GEMINI_API_KEY is present).  Set to any
# FREE OpenRouter model id.  The `openai/`-prefixed ids are resolved through
# OpenRouter's catalog, not the OpenAI endpoint.  During the test phase ONLY
# FREE models are allowed — paid models are forbidden at call time by
# _check_openrouter_model_not_paid() (raises RuntimeError BEFORE any call).
# Default (the best free option for BG drafting from the current list):
OPENROUTER_MODEL=google/gemma-4-31b
#   google/gemma-4-31b  262K ctx  $0/M  dense 30.7B, 140+ langs, doc understanding,
#                           coding, reasoning
#   VERIFY the exact id in your OpenRouter account: if Gemma 4 has a paid tier,
#   use google/gemma-4-31b:free instead of the plain id above.  Free-tier models
#   that have a paid tier use the `:free` suffix (e.g. qwen/qwen3.8-27b:free).
#   Models that are always free (no paid tier) use the plain id.
#
#   Full free-model list from the current OpenRouter free catalog (suitable for BG
#   drafting vs not, see src/editor_assistant/drafting/generate.py for the full
#   table with context sizes and notes):
#   Suitable for BG drafting:
#     google/gemma-4-31b               262K ctx  $0/M  (DEFAULT)
#     qwen/qwen3.8-27b:free            262K ctx  $0/M  (Qwen models are generally
#                                           strong at Bulgarian)
#     nvidia/nemotron-3-super:free      262K ctx  $0/M  (120B hybrid MoE, 12B active —
#                                           very capable but more agentic)
#     google/gemma-4-26b-a4b:free       262K ctx  $0/M  (3.8B active MoE)
#     thinkingmachines/inkling-small:free 1.05M ctx $0/M  (12B active MoE)
#     z-ai/glm-5.2:free                 1M ctx    $0/M  (reasoning/coding focus, large
#                                           context but not drafting-primary)
#   NOT suitable for BG drafting (specialized / too small / guardrail / coding):
#     inclusionai/ling-3.0-flash-sante:free  262K ctx  (medical)
#     nvidia/nemotron-3.5-content-safety:free 128K ctx (guardrail/moderation)
#     cohere/north-mini-code:free       256K ctx  (coding agent)
#     nex-agi/nex-n2.5-mini:free        262K ctx  (agentic coding)
#     poolside/laguna-xs-2.1:free       262K ctx  (coding agent)
#     nvidia/nemotron-3-nano-omni:free  256K ctx  (multimodal perception)
#     liquid/lfm-2.5-2.6b:free          66K ctx  (small, "not for knowledge-heavy")
#
#   Paid models explicitly forbidden during the test phase (set by
#   _OPENROUTER_PAID_FORBIDDEN in generate.py — a RuntimeError is raised
#   BEFORE any network call so a forbidden model never consumes quota):
#     openai/gpt-oss-20b              (the previous default — now forbidden)
#     openai/gpt-oss-120b             (more capable, ~5x cost — now forbidden)
#     openai/gpt-luna-5.6             (referenced as a future paid alternative for
#                                      drafts — add the exact id here once known;
#                                      forbidden during test phase)
#
# OpenRouter free-tier model: used ONLY when no Gemini key AND no explicit
# OPENROUTER_MODEL AND no explicit model arg — the experimentation path.
# Default (2026, current-age, JSON-instructable):
OPENROUTER_FREE_MODEL=qwen/qwen3.8-27b:free
#   Older default kept only as a historical reference (not a current recommendation):
#   meta-llama/llama-3.3-70b-instruct  (2024)
#
#   GEMINI_THINKING_BUDGET=0   (default) — send thinkingConfig.budget=0, disables
#                                internal reasoning for structured JSON output.
#   GEMINI_THINKING_BUDGET=-1  — hand thinking control back to the model (do NOT
#                                set this with gemini-3.5-flash-lite in the judge pool;
#                                it would re-introduce the 400).
#   GEMINI_MIN_GAP_SECONDS=5   process-wide pacing for the 15 RPM Lite buckets.
#   GEMINI_DRAFT_MODELS / GEMINI_JUDGE_MODELS : reorder or trim the pools.
#
# Jev is untouched by all of the above (see workflow/jev.py + JEV_MODEL in the
# M3J section below).

# ---------------------------------------------------------------------------
# M4 Daily Newsroom (source registry, daily collection, editor inbox)
# ---------------------------------------------------------------------------
# All optional. Defaults live under var/newsroom/ (git-ignored). The editor owns
# these stores through the Workbench (/sources, /inbox); override the paths only
# for tests or an isolated runtime:
#   NEWSROOM_DIR=/tmp/newsroom         # root for every newsroom store below
#   NEWSROOM_SOURCES_PATH=...           # source registry JSON (editor config)
#   NEWSROOM_INBOX_PATH=...            # collected candidates JSONL
#   NEWSROOM_SOURCE_HEALTH_PATH=...    # operational health (OK/EMPTY/FAILED/NEVER_RUN)
#   NEWSROOM_BLOCKED_DOMAINS_PATH=...  # blocked-domain policy (default flagman.bg)
#   NEWSROOM_LAST_RUN_PATH=...         # last collection summary
# WB_NEWSROOM_DIR=...                 # Workbench override for the same dir
#
# Editor frontend serving mode. Since the D2B cutover the compiled React SPA is
# the DEFAULT: the same Python process serves frontend/dist on the approved editor
# routes (/, /stories, /articles, /archive, /settings). /api/v1, /healthz and the
# operator surfaces stay backend routes in every mode. You do NOT need to set this
# variable for normal production behavior; the default already is the SPA.
#
# Any other value is a loud startup error, never a silent fallback: a typo must
# not silently hand the editor a different interface.
#
# Build the frontend first:  cd frontend && npm ci && npm run build && cd ..
# WB_EDITOR_FRONTEND=spa               # the default; shown for explicitness
# rollback, one variable, no migration / rebuild / data conversion:
# WB_EDITOR_FRONTEND=legacy            # server-rendered Workbench owns the routes
# WB_SPA_DIST=...                      # override the compiled build root
#
# Python 3.14.4, stdlib-only, no dependencies
